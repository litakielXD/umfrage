[Unit]
Description=Umfragen API (FastAPI)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/mondschule.de/public_html/umfrage
EnvironmentFile=/var/www/mondschule.de/public_html/umfrage/.env
ExecStart=/var/www/mondschule.de/public_html/umfrage/.venv/bin/uvicorn backend.app:app --host 127.0.0.1 --port 8012
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
